ont-weight:700;color:var(--ink)}\n.qa .a{color:var(--muted)}\n\n/* 客户端 */\n.client-card{display:flex;flex-direction:column;gap:10px}\n.client-card .plat{font-size:14px;color:var(--muted)}\n.client-card .note{font-size:13px;color:var(--muted)}\n\n/* 使用步骤 */\n.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n.step{padding:22px;border-radius:22px;background:var(--card);border:1px solid var(--line);box-shadow:0 16px 36px rgba(0,0,0,0.26)}\n.step .num{font-size:30px;font-weight:800;color:var(--amber)}\n.step h3{margin:8px 0 6px}\n.step p{color:var(--muted);font-size:14px;margin:0}\n\n/* footer */\nfooter{padding:36px 0;text-align:center;color:var(--muted);font-size:13px}\nfooter a{margin:0 8px}\n\n@media (max-width:860px){\n  .hero-title,.hero-lead{grid-column:1 / span 12}\n  .hero-stats{grid-template-columns:repeat(2,1fr)}\n  .grid-3,.grid-2,.grid-4,.steps{grid-template-columns:1fr}\n  .plan{grid-template-columns:1fr;width:100% !important;margin:0 0 12px 0 !important}\n}\n</style><main class=\"wrap\">\n  \n  <section class=\"hero\">\n    <div class=\"hero-grid\">\n      <div class=\"hero-head\">\n        <div class=\"brand\">小青蛙<span class=\"dot\">·</span></div>\n        <nav class=\"nav-anchors\">\n          <a href=\"#features\">特性</a>\n          <a href=\"#plans\">套餐</a>\n          <a href=\"#clients\">客户端</a>\n          <a href=\"#guide\">使用</a>\n          <a href=\"#faq\">常见问题</a>\n        </nav>\n      </div>\n\n      <div class=\"hero-title\">\n        <span class=\"tag\">轻巧出行</span>\n        <h1>小青蛙<br>轻装出发，畅连世界</h1>\n      </div>\n\n      <div class=\"hero-lead\">\n        <p>小青蛙专注于为日常上网、流媒体观影和远程办公提供轻量加速方案。三档套餐覆盖个人、进阶与团队，按需选择，按时计费。</p>\n        <p>节点池持续维护，客户端保持简洁，配置门槛低，上手不复杂。</p>\n      </div>\n\n      <div class=\"hero-stats\">\n        <div class=\"stat\"><div class=\"n\">3</div><div class=\"l\">档套餐可选</div></div>\n        <div class=\"stat\"><div class=\"n\">100GB+</div><div class=\"l\">起步流量</div></div>\n        <div class=\"stat\"><div class=\"n\">3–20</div><div class=\"l\">设备同时在线</div></div>\n        <div class=\"stat\"><div class=\"n\">24h</div><div class=\"l\">工单响应</div></div>\n      </div>\n\n      <div class=\"hero-quote\">\n        <p>“小而稳，先跑起来，再谈更快。” —— 小青蛙运营笔记</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"features\" class=\"section\">\n    <h2>它做什么</h2>\n    <div class=\"grid-3\">\n      <article class=\"card feature\">\n        <h3>轻量加速</h3>\n        <p>面向日常浏览与高清流媒体的稳定连接，控制延迟波动。</p>\n        <ul>\n          <li>多区域节点池</li>\n          <li>按套餐分配带宽</li>\n          <li>线路可手动切换</li>\n        </ul>\n      </article>\n      <article class=\"card feature\">\n        <h3>流媒体友好</h3>\n        <p>基础版解锁常见流媒体，旗舰版支持原生解锁与游戏加速优化。</p>\n        <ul>\n          <li>区域内容可达</li>\n          <li>IPLC 专线优化</li>\n          <li>低延迟游戏线路</li>\n        </ul>\n      </article>\n      <article class=\"card feature\">\n        <h3>团队协同</h3>\n        <p>团队版提供高带宽节点与企业定制路由，支持多人共享与专属客户经理。</p>\n        <ul>\n          <li>20 台设备在线</li>\n          <li>定制路由方案</li>\n          <li>专属经理对接</li>\n        </ul>\n      </article>\n    </div>\n  </section>\n\n  \n  <section id=\"plans\" class=\"section\">\n    <h2>三档套餐</h2>\n    <p class=\"muted\">阶梯式递进，按使用强度选择。年付更划算。</p>\n\n    <div class=\"plans\">\n      \n      <article class=\"plan tier-1\">\n        <div>\n          <div class=\"badge\">入门</div>\n          <h3>基础版</h3>\n          <div class=\"price\">¥15/月</div>\n          <div class=\"ann\">按年付仅需 ¥150/年</div>\n        </div>\n        <ul>\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <div class=\"muted\">适合轻度浏览与日常观影。</div>\n      </article>\n\n      \n      <article class=\"plan tier-2\">\n        <div>\n          <span class=\"badge\">推荐</span>\n          <h3>旗舰版</h3>\n          <div class=\"price\">¥35/月</div>\n          <div class=\"ann\">按年付仅需 ¥350/年</div>\n        </div>\n        <ul>\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <div class=\"muted\">适合重度流媒体与游戏用户。</div>\n      </article>\n\n      \n      <article class=\"plan tier-3\">\n        <div>\n          <span class=\"badge\">团队</span>\n          <h3>团队版</h3>\n          <div class=\"price\">¥85/月</div>\n          <div class=\"ann\">按年付仅需 ¥850/年</div>\n        </div>\n        <ul>\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <div class=\"muted\">适合小团队与远程办公。</div>\n      </article>\n    </div>\n  </section>\n\n  \n  <section id=\"clients\" class=\"section\">\n    <h2>客户端</h2>\n    <p class=\"muted\">常见平台均可使用。具体下载地址以官方公告为准。</p>\n    <div class=\"grid-3\">\n      <article class=\"card client-card\">\n        <h3>Windows</h3>\n        <div class=\"plat\">桌面端客户端</div>\n        <p class=\"note\">支持订阅导入与线路切换，适合日常办公使用。</p>\n        <a href=\"#\">获取方式待公布</a>\n      </article>\n      <article class=\"card client-card\">\n        <h3>macOS</h3>\n        <div class=\"plat\">桌面端客户端</div>\n        <p class=\"note\">兼容 Intel 与 Apple Silicon，界面简洁。</p>\n        <a href=\"#\">获取方式待公布</a>\n      </article>\n      <article class=\"card client-card\">\n        <h3>Android / iOS</h3>\n        <div class=\"plat\">移动端客户端</div>\n        <p class=\"note\">支持扫码导入与自动更新节点列表。</p>\n        <a href=\"#\">获取方式待公布</a>\n      </article>\n    </div>\n  </section>\n\n  \n  <section id=\"guide\" class=\"section\">\n    <h2>四步上手</h2>\n    <div class=\"steps\">\n      <div class=\"step\">\n        <div class=\"num\">01</div>\n        <h3>选套餐</h3>\n        <p>根据设备数量与流量需求，选择基础、旗舰或团队版。</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"num\">02</div>\n        <h3>装客户端</h3>\n        <p>按平台下载对应客户端，安装后登录账号。</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"num\">03</div>\n        <h3>导订阅</h3>\n        <p>复制订阅地址或扫码导入，客户端自动同步节点。</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"num\">04</div>\n        <h3>选线路</h3>\n        <p>从节点列表选择目标区域，连接后即可使用。</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"faq\" class=\"section\">\n    <h2>常见问题</h2>\n\n    <div class=\"faq-group\">\n      <h3>套餐与计费</h3>\n      <div class=\"qa\">\n        <div class=\"q\">月付和年付有什么区别？</div>\n        <div class=\"a\">月付按月扣费，灵活切换；年付一次性支付，价格更低。基础版年付 ¥150，旗舰版 ¥350，团队版 ¥850。</div>\n      </div>\n      <div class=\"qa\">\n        <div class=\"q\">流量用完会怎样？</div>\n        <div class=\"a\">套餐流量用尽后连接会受限，可升级到更高套餐或等待下个计费周期重置。</div>\n      </div>\n      <div class=\"qa\">\n        <div class=\"q\">可以随时升级套餐吗？</div>\n        <div class=\"a\">可以。升级按差额补费，新套餐权益立即生效，流量按比例继承。</div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>设备与兼容</h3>\n      <div class=\"qa\">\n        <div class=\"q\">一台账号能在几台设备上使用？</div>\n        <div class=\"a\">基础版 3 台，旗舰版 5 台，团队版 20 台。超出限制时，旧连接会被新连接替换。</div>\n      </div>\n      <div class=\"qa\">\n        <div class=\"q\">支持哪些平台？</div>\n        <div class=\"a\">常见桌面与移动平台均有客户端，具体下载方式以官方公告为准。</div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>使用与线路</h3>\n      <div class=\"qa\">\n        <div class=\"q\">看流媒体卡顿怎么办？</div>\n        <div class=\"a\">优先切换到原生解锁节点；若仍有波动，可尝试 IPLC 专线或联系工单排查。</div>\n      </div>\n      <div class=\"qa\">\n        <div class=\"q\">游戏加速是否支持所有游戏？</div>\n        <div class=\"a\">旗舰版提供 IPLC 专线游戏加速优化，适合主流海外游戏，不保证所有场景均生效。</div>\n      </div>\n      <div class=\"qa\">\n        <div class=\"q\">节点列表多久更新？</div>\n        <div class=\"a\">客户端订阅会定期同步节点信息，建议每周手动更新一次以获取最新线路。</div>\n      </div>\n    </div>\n  </section>\n\n  <footer>\n    <div>小青蛙 · 轻巧出行，畅连网络</div>\n    <div>\n      <a href=\"#features\">特性</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#guide\">使用</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n    <div>本页内容仅供参考，具体权益以官方最新说明为准。</div>\n  </footer>\n</main>",
